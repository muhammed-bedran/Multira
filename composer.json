{
    "name": "melbedran/multira",
    "description": "General-purpose Laravel localization: locale-prefixed URLs like mcamara, plus optional JSON model translations. No Google Translate.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "localization",
        "translation",
        "multilingual",
        "i18n",
        "locale",
        "mcamara",
        "multira",
        "melbedran"
    ],
    "authors": [
        {
            "name": "Melbedran",
            "homepage": "https://github.com/muhammed-bedran"
        }
    ],
    "homepage": "https://github.com/muhammed-bedran/Multira",
    "support": {
        "issues": "https://github.com/muhammed-bedran/Multira/issues",
        "source": "https://github.com/muhammed-bedran/Multira"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "illuminate/session": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Melbedran\\Multira\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Melbedran\\Multira\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Melbedran\\Multira\\MultiraServiceProvider"
            ],
            "aliases": {
                "Multira": "Melbedran\\Multira\\Facades\\Multira"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
